<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="246.0" prefWidth="263.0" spacing="20.0" styleClass="vbox-principal" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.practicajavafx2.LoginController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <VBox prefHeight="213.0" prefWidth="223.0">
      <children>
         <Label fx:id="lblTitulo" alignment="CENTER" prefHeight="31.0" prefWidth="197.0" text="ACCESO" textAlignment="CENTER" textFill="#ff000d" textOverrun="CLIP">
            <font>
               <Font name="System Bold Italic" size="21.0" />
            </font>
         </Label>
         <Label fx:id="lblUsuario" text="Usuario">
            <font>
               <Font name="System Bold" size="12.0" />
            </font>
         </Label>
         <TextField fx:id="txtUsuario" />
         <Label fx:id="lblContrasena" text="Contraseña">
            <font>
               <Font name="System Bold" size="12.0" />
            </font>
         </Label>
         <PasswordField fx:id="txtContrasena" />
         <Label text="Rol del Usuario" textFill="#030303">
            <font>
               <Font name="System Bold" size="12.0" />
            </font></Label>
         <ComboBox fx:id="cbxRol" prefHeight="25.0" prefWidth="185.0" promptText="Seleccione un rol" />
         <Label fx:id="lblValidacion" prefHeight="103.0" prefWidth="183.0" textFill="#1b1a1a">
            <padding>
               <Insets bottom="10.0" top="10.0" />
            </padding>
         </Label>
          <Button fx:id="btnValidar" alignment="CENTER" contentDisplay="CENTER" onAction="#validarCredenciales" prefHeight="40.0" prefWidth="97.0" styleClass="btn-primary" text="Ingresar" textAlignment="CENTER" textFill="#3c3c3c">
            <font>
               <Font name="System Bold" size="12.0" />
            </font>
            <VBox.margin>
               <Insets bottom="15.0" />
            </VBox.margin>
            <opaqueInsets>
               <Insets />
            </opaqueInsets>
            <stylesheets>
               <URL value="@../../../css/estilo.css" />
               <URL value="@../../../css/estilo.css" />
            </stylesheets>
         </Button>
         <Button fx:id="btnSalir" mnemonicParsing="false" onAction="#salirDelPrograma" styleClass="btn-danger" text="Salir" textFill="WHITE">
            <stylesheets>
               <URL value="@../../../css/estilo.css" />
               <URL value="@../../../css/estilo.css" />
            </stylesheets></Button>
      </children>
      <padding>
         <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
      </padding>
   </VBox>
   <stylesheets>
      <URL value="@../../../css/estilo.css" />
      <URL value="@../../../css/estilo.css" />
   </stylesheets>
</VBox>
